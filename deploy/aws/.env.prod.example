# Data Speak production environment for the API EC2 (copy to deploy/aws/.env.prod and fill in; never commit it).
# Loaded by docker-compose.prod.yml for the app, worker, scheduler and analytics containers.

# ---- Laravel ----
APP_NAME="Data Speak"
APP_ENV=production
APP_DEBUG=false
APP_KEY=                      # php artisan key:generate --show
APP_URL=https://api.example.com
FRONTEND_URL=https://app.example.com          # Amplify domain; verification links and CORS
CORS_ALLOWED_ORIGINS=                          # extra origins, comma-separated (e.g. the default amplifyapp.com URL)
TRUSTED_PROXIES=                               # leave empty when FrankenPHP terminates TLS itself; '*' behind an ALB
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
LOG_CHANNEL=json
LOG_LEVEL=info

# ---- FrankenPHP / Caddy ----
SERVER_NAME=api.example.com
ACME_EMAIL=ops@example.com

# ---- Amazon RDS (PostgreSQL 17) ----
DB_CONNECTION=pgsql
DB_HOST=dataspeak.xxxxxxxx.ap-southeast-1.rds.amazonaws.com
DB_PORT=5432
DB_DATABASE=dataspeak
DB_USERNAME=dataspeak
DB_PASSWORD=
DB_SSLMODE=require

# ---- Redis (container on this EC2) ----
REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null
QUEUE_CONNECTION=redis
CACHE_STORE=redis
SESSION_DRIVER=redis
REDIS_QUEUE_RETRY_AFTER=960

# ---- Analytics service (container on this EC2, internal network only) ----
ANALYTICS_BASE_URL=http://analytics:8000
ANALYTICS_INTERNAL_TOKEN=                      # openssl rand -hex 32 (same value is read by the analytics container)
ANALYTICS_TIMEOUT_SECONDS=30
MAX_UPLOAD_MB=50
UPLOAD_MAX_MB=50
UPLOAD_TTL_MINUTES=60

# ---- Ollama (installed natively on this EC2; the security group never exposes 11434) ----
# MVP sizing: CPU-only instance with 16 GB RAM -> qwen3:4b and OLLAMA_TIMEOUT=600. GPU instance -> qwen3:8b, 300.
# Separate GPU EC2 later: OLLAMA_BASE_URL=http://<its private IP>:11434 and open 11434 to this instance only.
AI_ENABLED=true
AI_LLM_DRIVER=ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_TIMEOUT=600
OLLAMA_TEMPERATURE=0.1
OLLAMA_SEED=42
OLLAMA_NUM_CTX=8192
OLLAMA_THINK=false
AI_PROMPT_VERSION=exec-interp-v7
AI_JOB_TIMEOUT_SECONDS=900
AI_CLAIM_VALIDATOR=rule_based
AUTO_REPORT=false
PRETRANSLATE_REPORTS=true

# ---- Mail (Amazon SES SMTP; the sender identity must be verified in SES) ----
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=email-smtp.ap-southeast-1.amazonaws.com
MAIL_PORT=587
MAIL_USERNAME=                                 # SES SMTP credentials (IAM user with ses:SendRawEmail)
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME="Data Speak"
# false = no email confirmation needed (use until a mail provider is configured); true = SES must be set up above
REQUIRE_VERIFIED_EMAIL=true
VERIFICATION_LINK_MINUTES=60
