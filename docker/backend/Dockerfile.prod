# Data Speak API - production image: FrankenPHP (Caddy + PHP 8.4) serving Laravel with automatic HTTPS.
# The same image runs the queue worker and the scheduler (different commands). Code is baked in; no bind mounts.
FROM dunglas/frankenphp:1-php8.4 AS base
ENV LANG=C.UTF-8 LC_ALL=C.UTF-8 SERVER_NAME=:80
RUN install-php-extensions pdo_pgsql pgsql intl zip gd opcache \
    && apt-get update && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*
COPY --from=composer:2 /usr/bin/composer /usr/bin/composer
# Production PHP settings: opcache on, no file stat churn, upload limits matching UPLOAD_MAX_MB.
RUN { \
      echo "opcache.enable=1"; echo "opcache.validate_timestamps=0"; echo "opcache.memory_consumption=192"; \
      echo "opcache.max_accelerated_files=20000"; echo "memory_limit=512M"; \
      echo "upload_max_filesize=60M"; echo "post_max_size=64M"; echo "max_execution_time=120"; \
      echo "expose_php=0"; \
    } > /usr/local/etc/php/conf.d/dataspeak.ini \
    && mv "$PHP_INI_DIR/php.ini-production" "$PHP_INI_DIR/php.ini"

WORKDIR /app
COPY backend/composer.json backend/composer.lock ./
RUN composer install --no-dev --no-scripts --no-autoloader --prefer-dist --no-interaction --no-progress
COPY backend/ ./
COPY deploy/aws/Caddyfile /etc/caddy/Caddyfile
COPY docker/backend/entrypoint.prod.sh /usr/local/bin/entrypoint.sh
RUN composer dump-autoload --optimize --classmap-authoritative --no-scripts \
    && mkdir -p storage/app/tmp storage/fonts storage/framework/cache/data storage/framework/sessions \
                storage/framework/views storage/logs bootstrap/cache \
    && chown -R www-data:www-data storage bootstrap/cache \
    && chmod +x /usr/local/bin/entrypoint.sh \
    && rm -f .env

VOLUME ["/app/storage"]
EXPOSE 80 443 443/udp
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
CMD ["frankenphp", "run", "--config", "/etc/caddy/Caddyfile"]
