APP_NAME="Data Speak"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
# Where email verification links send the browser after the API confirmed the address.
FRONTEND_URL=http://localhost:5173
# Extra browser origins allowed by CORS (comma-separated); FRONTEND_URL is always allowed.
CORS_ALLOWED_ORIGINS=
# Behind a TLS-terminating proxy/load balancer set '*' or a CIDR list so https is detected (AWS: see docs/DEPLOYMENT_AWS.md).
TRUSTED_PROXIES=
REQUIRE_VERIFIED_EMAIL=true

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=json
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=dataspeak
DB_USERNAME=dataspeak
DB_PASSWORD=dataspeak_dev
DB_CHARSET=utf8
# prefer locally; require for Amazon RDS
DB_SSLMODE=prefer

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Local development: docker compose runs Mailpit (UI http://127.0.0.1:8025). Compose sets MAIL_HOST=mailpit.
# Natively, `log` writes the email (with its link) to storage/logs/laravel.log.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Data Speak -------------------------------------------------------------
# Internal analytics service (FastAPI). Internal-only; never exposed to the browser.
ANALYTICS_BASE_URL=http://127.0.0.1:8001
ANALYTICS_INTERNAL_TOKEN=change-me-local-dev-token
ANALYTICS_TIMEOUT_SECONDS=30

# One-click flow: run analysis, then generate the report automatically (set false to require POST /report).
AUTO_REPORT=false
# Translate every new report into the other languages in the background so switching is instant.
PRETRANSLATE_REPORTS=true

# Transient CSV handling (FEAT-UPL-003). Minutes before an un-run upload is purged.
UPLOAD_TTL_MINUTES=60
UPLOAD_MAX_MB=50

# AI interpretation (MOD-09) via a local Ollama server. Internal-only. Pull the model during setup:
#   ollama pull qwen3:8b
# In Docker on macOS use http://host.docker.internal:11434 (native Ollama); with the compose
# 'ollama' profile use http://ollama:11434.
AI_ENABLED=true
AI_LLM_DRIVER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_TIMEOUT=300
OLLAMA_TEMPERATURE=0.1
OLLAMA_SEED=42
OLLAMA_NUM_CTX=8192
OLLAMA_THINK=false
AI_PROMPT_VERSION=exec-interp-v7
AI_REPORT_LANGUAGE=English
AI_JOB_TIMEOUT_SECONDS=900
AI_CLAIM_VALIDATOR=rule_based
