# Root compose environment. Copy to .env for local development. No real secrets here.
COMPOSE_PROJECT_NAME=dataspeak

POSTGRES_DB=dataspeak
POSTGRES_USER=dataspeak
POSTGRES_PASSWORD=dataspeak_dev

# Shared internal token between Laravel and FastAPI (generate your own: openssl rand -hex 32)
ANALYTICS_INTERNAL_TOKEN=change-me-local-dev-token

# Host port bindings (all loopback except frontend/backend)
FRONTEND_PORT=5173
BACKEND_PORT=8000
ANALYTICS_LOOPBACK_PORT=8001
POSTGRES_LOOPBACK_PORT=5432
REDIS_LOOPBACK_PORT=6379

# AI Gateway (Ollama). Native Ollama on the host is the default; see docker-compose.yml 'ollama' profile.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3:8b
